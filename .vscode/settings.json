{
  // "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  "[php]": {
    "editor.wordSeparators": "`~!@#%^&*()-=+[{]}\\|;:'\",.<>/?"
  },
  "[css]": {
    "editor.wordSeparators": "`~!$%^&*()=+[{]}\\|;:'\",.<>/?"
  },
  "files.defaultLanguage": "markdown",
  "files.associations": {
    "*.pict": "powershell",
  },
  "chat.editor.localAgent.enabled": true,
  "chat.editor.preferCopilotHarness": false,
  "chat.defaultToCopilotHarness": false,
  "github.copilot.chat.agentDebugLog.fileLogging.enabled": false,
  "chat.agentHost.agentDebugLog.enabled": false
}
